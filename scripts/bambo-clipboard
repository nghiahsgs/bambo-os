#!/usr/bin/env python3
"""bambo-clipboard: share the Wayland clipboard with the host of a VM.

`make try` adds a virtio port named org.bambo.clipboard and runs
scripts/clipboard-host.py on the Mac. Each side sends one line per clipboard
change: the text as base64, 1 MiB at most. A PNG image, such as a screenshot,
goes from here to the host as "img:" plus base64, 8 MiB at most. Images do not
come the other way. On a real machine the port does not exist and this exits
at once.

The idea (a guest agent on a virtio port, wl-clipboard on this end) comes from
Try Omarchy (github.com/omacom/try-omarchy, MIT).
"""
import base64
import hashlib
import os
import subprocess
import sys
import threading
import time

PORT = "/dev/virtio-ports/org.bambo.clipboard"
MAX_BYTES = 1024 * 1024
MAX_IMAGE_BYTES = 8 * 1024 * 1024
last = None
lock = threading.Lock()


def read_clipboard():
    for mime in ("text/plain;charset=utf-8", "text/plain"):
        got = subprocess.run(["wl-paste", "--no-newline", "--type", mime], capture_output=True)
        if got.returncode == 0:
            return got.stdout
    return None


def read_image():
    """The clipboard as PNG bytes, or None when it holds no PNG."""
    types = subprocess.run(["wl-paste", "--list-types"], capture_output=True).stdout.split()
    if b"image/png" not in types:
        return None
    got = subprocess.run(["wl-paste", "--type", "image/png"], capture_output=True)
    return got.stdout if got.returncode == 0 else None


def send(port, data):
    """Write all of data. The port is unbuffered, so one write may be short."""
    view = memoryview(data)
    while view:
        view = view[port.write(view):]


def note_incoming(text):
    """Tell bambo-copied which text came from the host, so it stays quiet about it."""
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    # Same form bambo-copied hashes: a shell $(...) drops trailing newlines.
    digest = hashlib.sha256(text.rstrip(b"\n")).hexdigest()
    try:
        with open(os.path.join(runtime, "bambo-clipboard.in"), "w") as f:
            f.write(digest + "\n")
    except OSError:
        pass


def from_host(port):
    """Host lines become the Wayland clipboard."""
    global last
    for line in port:
        try:
            text = base64.b64decode(line.strip(), validate=True)
        except ValueError:
            continue
        if not text or len(text) > MAX_BYTES:
            continue
        with lock:
            last = text
        note_incoming(text)
        subprocess.run(["wl-copy", "--type", "text/plain;charset=utf-8"], input=text)


def main():
    global last
    if not os.path.exists(PORT):
        return 0
    for _ in range(50):  # udev grants access a moment after login
        if os.access(PORT, os.R_OK | os.W_OK):
            break
        time.sleep(0.2)
    port = open(PORT, "r+b", buffering=0)
    port.write(b"hello\n")
    threading.Thread(target=from_host, args=(os.fdopen(os.dup(port.fileno()), "rb"),), daemon=True).start()

    # wl-paste --watch prints one line per clipboard change.
    watch = subprocess.Popen(["wl-paste", "--watch", "echo", "changed"], stdout=subprocess.PIPE)
    for _ in watch.stdout:
        text = read_clipboard()
        if not text:
            image = read_image()
            # No echo check: images never come back from the host, and the
            # same picture copied twice must reach the host twice.
            if image and len(image) <= MAX_IMAGE_BYTES:
                send(port, b"img:" + base64.b64encode(image) + b"\n")
            continue
        if len(text) > MAX_BYTES:
            continue
        with lock:
            if text == last:
                continue
            last = text
        send(port, base64.b64encode(text) + b"\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
