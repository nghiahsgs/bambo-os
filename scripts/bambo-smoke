#!/usr/bin/env bash
# bambo-smoke: live session only. Writes status markers to the first serial port
# so CI can tell from outside the VM whether the desktop came up.
# On real hardware nothing listens on the port and the writes are dropped.
tty=/dev/ttyS0
[[ -c $tty ]] || exit 0

say() {
  # shellcheck disable=SC2016
  timeout 2 bash -c 'printf "%s\r\n" "$1" >"$2"' _ "$*" "$tty" 2>/dev/null || true
}

say "BAMBO_LIVE_READY"
say "BAMBO_PKGS=$(pacman -Qq | wc -l)"

for _ in {1..120}; do
  pgrep -xi hyprland >/dev/null && break
  sleep 1
done

if pgrep -xi hyprland >/dev/null; then
  say "BAMBO_DESKTOP_READY"
else
  say "BAMBO_DESKTOP_FAILED"
  while IFS= read -r line; do say "LOG: $line"; done < <(
    tail -n 40 /run/user/1000/hypr/*/hyprland.log 2>/dev/null
    journalctl -b --no-pager -n 30 2>/dev/null
  )
fi

# Install test: only when the VM carries the SMBIOS OEM string "bambo-smoke-install".
# Runs bambo-install unattended on the blank virtio disk, plants this script on the
# installed system so the next boot reports too, then powers off.
if grep -qa bambo-smoke-install /sys/firmware/dmi/entries/11-0/raw 2>/dev/null; then
  for _ in {1..180}; do
    systemctl is-active --quiet pacman-init.service && break
    sleep 1
  done
  if BAMBO_UNATTENDED=1 BAMBO_DISK=/dev/vda BAMBO_HOSTNAME=bambovm BAMBO_USER=dev \
    BAMBO_PASSWORD=bambo-ci-only bambo-install >/tmp/bambo-install.log 2>&1; then
    mount /dev/vda2 /mnt
    install -m 755 /usr/local/bin/bambo-smoke /mnt/usr/local/bin/bambo-smoke
    printf '[Unit]\nAfter=multi-user.target\n[Service]\nExecStart=/usr/local/bin/bambo-smoke\n[Install]\nWantedBy=multi-user.target\n' \
      >/mnt/etc/systemd/system/bambo-smoke.service
    ln -s ../bambo-smoke.service /mnt/etc/systemd/system/multi-user.target.wants/bambo-smoke.service
    say "BAMBO_INSTALLED_PKGS=$(pacman -Qq --root /mnt | wc -l)"
    say "BAMBO_INSTALLED_DISK_MB=$(df -m --output=used /mnt | tail -n1 | tr -d ' ')"
    umount /mnt
    say "BAMBO_INSTALL_TIME=$(grep -ao 'installed on .*' /tmp/bambo-install.log | tail -n1)"
    say "BAMBO_INSTALL=ok"
  else
    say "BAMBO_INSTALL=failed"
    while IFS= read -r line; do say "LOG: $line"; done < <(tail -n 40 /tmp/bambo-install.log)
  fi
  say "BAMBO_SMOKE_DONE"
  exit 0
fi

sleep 30
say "BAMBO_MEM_USED_MB=$(free -m | awk '/^Mem:/ {print $3}')"
say "BAMBO_WAYBAR=$(pgrep -x waybar >/dev/null && echo up || echo down)"

# Full exercise: only when the VM was started with the SMBIOS OEM string
# "bambo-smoke-full" (scripts/smoke-test.sh does that). Never on real hardware.
if grep -qa bambo-smoke-full /sys/firmware/dmi/entries/11-0/raw 2>/dev/null; then
  run=/run/user/1000
  wl="$(find "$run" -maxdepth 1 -name 'wayland-*' ! -name '*.lock' -printf '%f\n' | head -n1)"
  as_user() {
    runuser -u bambo -- env HOME=/home/bambo XDG_RUNTIME_DIR="$run" WAYLAND_DISPLAY="$wl" \
      PATH=/usr/local/bin:/usr/bin "$@" >/dev/null 2>&1
  }

  as_user hyprctl -i 0 dispatch 'hl.dsp.exec_cmd("kitty --hold bambo-fetch")'
  sleep 10
  say "BAMBO_TERMINAL=$(pgrep -x kitty >/dev/null && echo up || echo down)"
  sleep 4 # the host takes a screenshot on the marker above

  as_user bambo-shot full
  shot="$(find /home/bambo/Pictures -name 'screenshot-*.png' -size +1k 2>/dev/null | head -n1)"
  say "BAMBO_SCREENSHOT=$([[ -n $shot ]] && echo ok || echo missing)"

  as_user bambo-record toggle
  sleep 5
  as_user bambo-record toggle
  sleep 1
  rec="$(find /home/bambo/Videos -name 'recording-*.mp4' -size +1k 2>/dev/null | head -n1)"
  say "BAMBO_RECORDING=$([[ -n $rec ]] && echo ok || echo missing)"

  as_user hyprctl -i 0 dispatch 'hl.dsp.exec_cmd("chromium")'
  sleep 25
  say "BAMBO_BROWSER=$(pgrep -x chromium >/dev/null && echo up || echo down)"
fi
say "BAMBO_SMOKE_DONE"
